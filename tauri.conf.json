{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAF Trainer",
  "version": "0.1.0",
  "identifier": "com.daftrainer.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DAF Trainer",
        "width": 900,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icon.ico",
      "icon.png"
    ]
  }
}
